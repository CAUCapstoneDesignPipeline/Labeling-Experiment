# 라벨 파일 — 라벨링 진행 중에는 커밋하지 않는다
#
# 3인이 서로의 라벨을 보면 독립성이 깨져 일치도 측정이 무의미해진다.
# 전원이 완료한 뒤 아래 줄을 지우고 한꺼번에 커밋한다.
#   git add -f data/*/labels_*.jsonl
# ─────────────────────────────────────────────────────────
data/*/labels_*.jsonl

